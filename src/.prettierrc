{
    "plugins": ["@prettier/plugin-php"],
    "phpVersion": "8.4",
    "singleQuote": true,
    "tabWidth": 4,
    "printWidth": 120,
    "useTabs": false,
    "overrides": [
        {
            "files": "*.blade.php",
            "options": {
                "parser": "php"
            }
        }
    ]
}
